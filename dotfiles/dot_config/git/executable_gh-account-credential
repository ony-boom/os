#!/bin/sh
# Git credential helper that answers with the token of one specific gh account,
# so GitHub remotes can be routed to different accounts by URL (see config).
#   helper = !~/.config/git/gh-account-credential <gh-login>
user=$1
action=$2
cat >/dev/null
[ "$action" = get ] || exit 0
token=$(gh auth token --hostname github.com --user "$user" 2>/dev/null) || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$token"
